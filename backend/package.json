{
  "name": "kaisign-eigenda-backend",
  "version": "1.0.0",
  "description": "Backend service for KaiSign with EigenDA integration",
  "main": "eigenda-api.js",
  "scripts": {
    "start": "node eigenda-api.js",
    "dev": "nodemon eigenda-api.js",
    "docker:up": "docker-compose -f ../docker-compose.eigenda.yml up -d",
    "docker:down": "docker-compose -f ../docker-compose.eigenda.yml down",
    "docker:logs": "docker-compose -f ../docker-compose.eigenda.yml logs -f"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "axios": "^1.6.0",
    "ethers": "^6.9.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}