# Minimal environment template (only variables referenced by the app)

# Server-side only (do NOT prefix with NEXT_PUBLIC_)
PINATA_JWT=
ALCHEMY_RPC_URL=
ETHERSCAN_API_KEY=
GOOGLE_GENAI_API_KEY=
# Server Graph endpoint override used by some API routes (optional)
KAISIGN_GRAPH_ENDPOINT=

# Blob posting configuration (for UserOp-based blob transactions)
BLOB_POSTER_PRIVATE_KEY=
BLOB_RPC_URL=
BUNDLER_PRIVATE_KEY=
BUNDLER_PORT=3000

# Public (available to client)
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_KAISIGN_CONTRACT_ADDRESS=
NEXT_PUBLIC_IPFS_GATEWAY_URL=https://ipfs.io/ipfs
NEXT_PUBLIC_KAISIGN_GRAPH_URL=
NEXT_PUBLIC_REALITY_ETH_GRAPH_URL=
NEXT_PUBLIC_GTM=
NEXT_PUBLIC_ONETRUST=

# Blob posting feature flag
NEXT_PUBLIC_USE_BLOB_POSTING=false
NEXT_PUBLIC_BLOB_FACTORY_ADDRESS=
NEXT_PUBLIC_BUNDLER_URL=http://localhost:3000/rpc

# Optional/legacy (kept for backward compat; safe to omit)
# NEXT_PUBLIC_IPFS_API_KEY=
# NEXT_PUBLIC_IPFS_API_SECRET=
# NEXT_PUBLIC_ALCHEMY_RPC_URL=