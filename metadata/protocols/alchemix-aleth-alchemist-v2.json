{
  "$schema": "https://eips.ethereum.org/assets/eip-7730/erc7730-v2.schema.json",
  "context": {
    "contract": {
      "deployments": [
        {
          "chainId": 1,
          "address": "0x062bf725dc4cdf947aa79ca2aaccd4f385b13b5c"
        }
      ]
    }
  },
  "metadata": {
    "owner": "Alchemix Finance",
    "contractName": "Alchemix alETH AlchemistV2"
  },
  "display": {
    "formats": {
      "deposit(address yieldToken,uint256 amount,address recipient)": {
        "intent": "Deposit to Alchemix alETH",
        "interpolatedIntent": "Deposit {amount} of yield token {yieldToken} to Alchemix for {recipient}",
        "fields": [
          { "path": "yieldToken", "label": "Yield Token", "format": "addressName" },
          { "path": "amount", "label": "Amount", "format": "tokenAmount", "params": { "tokenPath": "yieldToken" } },
          { "path": "recipient", "label": "Recipient", "format": "addressName" }
        ]
      },
      "depositUnderlying(address yieldToken,uint256 amount,address recipient,uint256 minimumAmountOut)": {
        "intent": "Deposit underlying to Alchemix alETH",
        "interpolatedIntent": "Deposit {amount} underlying for {yieldToken} to Alchemix for {recipient}",
        "fields": [
          { "path": "yieldToken", "label": "Yield Token", "format": "addressName" },
          { "path": "amount", "label": "Amount", "format": "raw" },
          { "path": "recipient", "label": "Recipient", "format": "addressName" },
          { "path": "minimumAmountOut", "label": "Min Amount Out", "format": "raw" }
        ]
      },
      "withdraw(address yieldToken,uint256 shares,address recipient)": {
        "intent": "Withdraw from Alchemix alETH",
        "interpolatedIntent": "Withdraw {shares} shares of {yieldToken} from Alchemix to {recipient}",
        "fields": [
          { "path": "yieldToken", "label": "Yield Token", "format": "addressName" },
          { "path": "shares", "label": "Shares", "format": "raw" },
          { "path": "recipient", "label": "Recipient", "format": "addressName" }
        ]
      },
      "withdrawUnderlying(address yieldToken,uint256 shares,address recipient,uint256 minimumAmountOut)": {
        "intent": "Withdraw underlying from Alchemix alETH",
        "interpolatedIntent": "Withdraw {shares} shares of {yieldToken} as underlying from Alchemix to {recipient}",
        "fields": [
          { "path": "yieldToken", "label": "Yield Token", "format": "addressName" },
          { "path": "shares", "label": "Shares", "format": "raw" },
          { "path": "recipient", "label": "Recipient", "format": "addressName" },
          { "path": "minimumAmountOut", "label": "Min Amount Out", "format": "raw" }
        ]
      },
      "mint(uint256 amount,address recipient)": {
        "intent": "Mint alETH from Alchemix",
        "interpolatedIntent": "Mint {amount} alETH to {recipient}",
        "fields": [
          { "path": "amount", "label": "alETH Amount", "format": "amount", "params": { "decimals": 18, "symbol": "alETH" } },
          { "path": "recipient", "label": "Recipient", "format": "addressName" }
        ]
      },
      "burn(uint256 amount,address recipient)": {
        "intent": "Burn alETH to reduce Alchemix debt",
        "interpolatedIntent": "Burn {amount} alETH to reduce debt for {recipient}",
        "fields": [
          { "path": "amount", "label": "alETH Amount", "format": "amount", "params": { "decimals": 18, "symbol": "alETH" } },
          { "path": "recipient", "label": "Account", "format": "addressName" }
        ]
      },
      "repay(address underlyingToken,uint256 amount,address recipient)": {
        "intent": "Repay Alchemix alETH debt",
        "interpolatedIntent": "Repay {amount} of {underlyingToken} to reduce debt for {recipient}",
        "fields": [
          { "path": "underlyingToken", "label": "Underlying Token", "format": "addressName" },
          { "path": "amount", "label": "Amount", "format": "tokenAmount", "params": { "tokenPath": "underlyingToken" } },
          { "path": "recipient", "label": "Account", "format": "addressName" }
        ]
      },
      "liquidate(address yieldToken,uint256 shares,uint256 minimumAmountOut)": {
        "intent": "Self-liquidate Alchemix alETH position",
        "interpolatedIntent": "Liquidate {shares} shares of {yieldToken} from Alchemix",
        "fields": [
          { "path": "yieldToken", "label": "Yield Token", "format": "addressName" },
          { "path": "shares", "label": "Shares", "format": "raw" },
          { "path": "minimumAmountOut", "label": "Min Amount Out", "format": "raw" }
        ]
      }
    }
  }
}
