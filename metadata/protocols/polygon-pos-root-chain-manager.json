            {
              "name": "user",
              "type": "address"
            }
          ],
          "stateMutability": "payable"
        },
        {
          "type": "function",
          "name": "depositFor",
          "selector": "0xe3dec8fb",
          "inputs": [
            {
              "name": "user",
              "type": "address"
            },
            {
              "name": "rootToken",
              "type": "address"
            },
            {
              "name": "depositData",
              "type": "bytes"
            }
          ],
          "stateMutability": "nonpayable"
        },
        {
          "type": "function",
          "name": "exit",
          "selector": "0x3805550f",
          "inputs": [
            {
              "name": "inputData",
              "type": "bytes"
            }
          ],
          "stateMutability": "nonpayable"
        },
        {
          "type": "function",
          "name": "transferProxyOwnership",
          "selector": "0xf1739cae",
          "inputs": [
            {
              "internalType": "address",
              "name": "newOwner",
              "type": "address"
            }
          ],
          "stateMutability": "nonpayable"
        },
        {
          "type": "function",
          "name": "updateAndCall",
          "selector": "0xd88ca2c8",
          "inputs": [
            {
              "internalType": "address",
              "name": "_newProxyTo",
              "type": "address"
            },
            {
              "internalType": "bytes",
              "name": "data",
              "type": "bytes"
            }
          ],
          "stateMutability": "payable"
        },
        {
          "type": "function",
          "name": "updateImplementation",
          "selector": "0x025b22bc",
          "inputs": [
            {
              "internalType": "address",
              "name": "_newProxyTo",
              "type": "address"
            }
          ],
          "stateMutability": "nonpayable"
        }
      ]
