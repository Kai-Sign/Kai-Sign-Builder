  "display": {
    "formats": {
      "depositEtherFor(address)": {
        "intent": "Bridge ETH to Polygon PoS",
        "interpolatedIntent": "Bridge ETH to Polygon PoS for {user}",
        "fields": [
          {
            "path": "user",
            "label": "Polygon Recipient",
            "format": "addressName"
          }
        ]
      },
      "depositFor(address,address,bytes)": {
        "intent": "Bridge ERC-20 tokens to Polygon PoS",
        "interpolatedIntent": "Bridge {rootToken} to Polygon PoS for {user}",
        "fields": [
          {
            "path": "user",
            "label": "Polygon Recipient",
            "format": "addressName"
          },
          {
            "path": "rootToken",
            "label": "Token to Bridge",
            "format": "addressName"
          }
        ]
      },
      "exit(bytes)": {
        "intent": "Claim tokens from Polygon PoS back to Ethereum",
        "interpolatedIntent": "Finalize Polygon PoS withdrawal to Ethereum",
        "fields": [
          {
            "path": "inputData",
            "label": "Exit Proof Data",
            "format": "raw"
          }
        ]
      },
      "transferProxyOwnership(address)": {
        "intent": "Review Transfer Proxy Ownership transaction",
        "fields": [
          {
            "path": "newOwner",
            "label": "New Owner",
            "format": "address"
          }
        ]
      },
      "updateAndCall(address,bytes)": {
        "intent": "Review Update And Call transaction",
        "fields": [
          {
            "path": "_newProxyTo",
            "label": " new Proxy To",
            "format": "address"
          },
          {
            "path": "data",
            "label": "Data",
            "format": "hex"
          }
        ]
      },
      "updateImplementation(address)": {
        "intent": "Review Update Implementation transaction",
        "fields": [
          {
            "path": "_newProxyTo",
            "label": " new Proxy To",
            "format": "address"
          }
        ]
      }
    }
  },
  "metadata": {
    "owner": "Polygon",
    "info": {
      "url": "https://wallet.polygon.technology/polygon/bridge/deposit",
      "legalName": "Polygon Technology",
      "lastUpdate": "2026-03-27"
    }
  }
