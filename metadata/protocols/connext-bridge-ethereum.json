{
  "$schema": "../../erc7730-v1.schema.json",
  "context": {
    "contract": {
      "address": "0x8898b472c54c31894e3b9bb83cea802a5d0e63c6",
      "chainId": 1,
      "name": "Connext Bridge (Ethereum)",
      "abi": [
        {
          "type": "function",
          "name": "xcall",
          "selector": "0xa0c57e8f",
          "inputs": [
            { "name": "_destination", "type": "uint32" },
            { "name": "_to", "type": "address" },
            { "name": "_asset", "type": "address" },
            { "name": "_delegate", "type": "address" },
            { "name": "_amount", "type": "uint256" },
            { "name": "_slippage", "type": "uint256" },
            { "name": "_callData", "type": "bytes" }
          ],
          "stateMutability": "payable"
        },
        {
          "type": "function",
          "name": "xcallIntoLocal",
          "selector": "0x386ba4f8",
          "inputs": [
            { "name": "_destination", "type": "uint32" },
            { "name": "_to", "type": "address" },
            { "name": "_asset", "type": "address" },
            { "name": "_delegate", "type": "address" },
            { "name": "_amount", "type": "uint256" },
            { "name": "_slippage", "type": "uint256" },
            { "name": "_callData", "type": "bytes" }
          ],
          "stateMutability": "payable"
        },
        {
          "type": "function",
          "name": "bumpTransfer",
          "selector": "0x54164cba",
          "inputs": [
            { "name": "_transferId", "type": "bytes32" }
          ],
          "stateMutability": "payable"
        }
      ]
    }
  },
  "display": {
    "formats": {
      "xcall(uint32,address,address,address,uint256,uint256,bytes)": {
        "intent": "Bridge tokens via Connext to another chain",
        "interpolatedIntent": "Bridge {_amount} {_asset} to chain {_destination} via Connext to {_to}",
        "fields": [
          { "path": "_asset", "label": "Asset", "format": "addressName" },
          { "path": "_amount", "label": "Amount", "format": "tokenAmount", "params": { "tokenPath": "_asset" } },
          { "path": "_destination", "label": "Destination Domain", "format": "raw" },
          { "path": "_to", "label": "Recipient", "format": "addressName" },
          { "path": "_slippage", "label": "Max Slippage (bps)", "format": "raw" },
          { "path": "_delegate", "label": "Delegate", "format": "addressName" }
        ]
      },
      "xcallIntoLocal(uint32,address,address,address,uint256,uint256,bytes)": {
        "intent": "Bridge tokens via Connext (receive local asset)",
        "interpolatedIntent": "Bridge {_amount} {_asset} to chain {_destination} as local asset via Connext",
        "fields": [
          { "path": "_asset", "label": "Asset", "format": "addressName" },
          { "path": "_amount", "label": "Amount", "format": "tokenAmount", "params": { "tokenPath": "_asset" } },
          { "path": "_destination", "label": "Destination Domain", "format": "raw" },
          { "path": "_to", "label": "Recipient", "format": "addressName" },
          { "path": "_slippage", "label": "Max Slippage (bps)", "format": "raw" }
        ]
      },
      "bumpTransfer(bytes32)": {
        "intent": "Add additional relayer fee to Connext transfer",
        "interpolatedIntent": "Bump relayer fee for Connext transfer {_transferId}",
        "fields": [
          { "path": "_transferId", "label": "Transfer ID", "format": "raw" }
        ]
      }
    }
  },
  "metadata": {
    "owner": "Connext",
    "info": {
      "url": "https://connext.network/",
      "legalName": "Connext Protocol",
      "lastUpdate": "2026-03-25"
    }
  }
}
