{
  "$schema": "https://eips.ethereum.org/assets/eip-7730/erc7730-v2.schema.json",
  "context": {
    "contract": {
      "deployments": [
        {
          "chainId": 1,
          "address": "0x0a3f6849f78076aefadf113f5bed87720274ddc0"
        }
      ]
    }
  },
  "metadata": {
    "owner": "MakerDAO",
    "contractName": "MakerDAO Chief (MKR Executive Vote)"
  },
  "display": {
    "formats": {
      "vote(bytes32 slate)": {
        "intent": "Vote on MakerDAO executive proposal (by slate)",
        "interpolatedIntent": "Vote for executive slate {slate} in MakerDAO",
        "fields": [
          { "path": "slate", "label": "Slate Hash", "format": "raw" }
        ]
      },
      "vote(address[] yays)": {
        "intent": "Vote on MakerDAO executive proposal (by addresses)",
        "interpolatedIntent": "Vote for MakerDAO executive proposal",
        "fields": [
          { "path": "yays", "label": "Proposal Addresses", "format": "raw" }
        ]
      },
      "lift(address whom)": {
        "intent": "Lift MakerDAO executive hat",
        "interpolatedIntent": "Lift {whom} as the new MakerDAO executive hat",
        "fields": [
          { "path": "whom", "label": "Hat Address", "format": "addressName" }
        ]
      },
      "lock(uint256 wad)": {
        "intent": "Lock MKR for governance voting",
        "interpolatedIntent": "Lock {wad} MKR to participate in MakerDAO governance",
        "fields": [
          { "path": "wad", "label": "MKR to Lock", "format": "amount", "params": { "decimals": 18, "symbol": "MKR" } }
        ]
      },
      "free(uint256 wad)": {
        "intent": "Unlock MKR from governance",
        "interpolatedIntent": "Unlock {wad} MKR from MakerDAO governance",
        "fields": [
          { "path": "wad", "label": "MKR to Unlock", "format": "amount", "params": { "decimals": 18, "symbol": "MKR" } }
        ]
      }
    }
  }
}
