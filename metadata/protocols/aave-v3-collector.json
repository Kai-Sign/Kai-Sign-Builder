{
  "$schema": "https://eips.ethereum.org/assets/eip-7730/erc7730-v2.schema.json",
  "context": {
    "contract": {
      "deployments": [
        {
          "chainId": 1,
          "address": "0x464C71f6c2F760DdA6093dCB91C24c39e5d6e18c"
        }
      ],
      "abi": [
        {"type": "function", "name": "approve", "selector": "0xf9e54204", "inputs": [{"name": "token", "type": "address"}, {"name": "amount", "type": "uint256"}]},
        {"type": "function", "name": "transfer", "selector": "0x04292e8b", "inputs": [{"name": "token", "type": "address"}, {"name": "recipient", "type": "address"}, {"name": "amount", "type": "uint256"}]},
        {"type": "function", "name": "swap", "selector": "0x00000000", "inputs": [{"name": "tokenIn", "type": "address"}, {"name": "tokenOut", "type": "address"}, {"name": "amountIn", "type": "uint256"}, {"name": "minAmountOut", "type": "uint256"}, {"name": "calldata", "type": "bytes"}]}
      ]
    }
  },
  "metadata": {
    "owner": "Aave",
    "contractName": "Aave V3 Collector (Treasury)",
    "info": {
      "website": "https://aave.com",
      "docs": "https://docs.aave.com/developers/core/collector"
    }
  },
  "display": {
    "formats": {
      "approve(address,uint256)": {
        "intent": "Approve Token Transfer from Treasury",
        "fields": [
          {"path": "token", "label": "Token", "format": "tokenAmount"},
          {"path": "amount", "label": "Amount", "format": "amount"}
        ]
      },
      "transfer(address,address,uint256)": {
        "intent": "Transfer {amount} from Treasury",
        "fields": [
          {"path": "token", "label": "Token", "format": "tokenAmount"},
          {"path": "recipient", "label": "Recipient", "format": "addressName"},
          {"path": "amount", "label": "Amount", "format": "amount"}
        ]
      },
      "swap(address,address,uint256,uint256,bytes)": {
        "intent": "Swap Treasury Funds",
        "fields": [
          {"path": "tokenIn", "label": "Token In", "format": "tokenAmount"},
          {"path": "tokenOut", "label": "Token Out", "format": "tokenAmount"},
          {"path": "amountIn", "label": "Amount In", "format": "amount"},
          {"path": "minAmountOut", "label": "Min Amount Out", "format": "amount"},
          {"path": "calldata", "label": "Swap Calldata", "format": "raw"}
        ]
      }
    }
  }
}
