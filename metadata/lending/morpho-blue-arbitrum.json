{
  "$schema": "https://eips.ethereum.org/assets/eip-7730/erc7730-v2.schema.json",
  "context": {
    "contract": {
      "deployments": [
        {
          "chainId": 1,
          "address": "0xbbbbbbbbbb9cc5e90e3b3af64bdaf62c37eeffcb"
        }
      ]
    }
  },
  "metadata": {
    "owner": "Morpho Labs",
    "contractName": "Morpho Blue (Arbitrum)"
  },
  "display": {
    "formats": {
      "supply((address loanToken,address collateralToken,address oracle,address irm,uint256 lltv) marketParams,uint256 assets,uint256 shares,address onBehalf,bytes data)": {
        "intent": "Supply to Morpho Blue",
        "interpolatedIntent": "Supply {assets} to Morpho Blue market",
        "fields": [
          { "path": "marketParams.loanToken", "label": "Loan Token", "format": "addressName" },
          { "path": "marketParams.collateralToken", "label": "Collateral Token", "format": "addressName" },
          { "path": "assets", "label": "Amount", "format": "tokenAmount", "params": { "tokenPath": "marketParams.loanToken" } },
          { "path": "onBehalf", "label": "On Behalf Of", "format": "addressName" }
        ]
      },
      "withdraw((address loanToken,address collateralToken,address oracle,address irm,uint256 lltv) marketParams,uint256 assets,uint256 shares,address onBehalf,address receiver)": {
        "intent": "Withdraw from Morpho Blue",
        "interpolatedIntent": "Withdraw {assets} from Morpho Blue market",
        "fields": [
          { "path": "marketParams.loanToken", "label": "Loan Token", "format": "addressName" },
          { "path": "marketParams.collateralToken", "label": "Collateral Token", "format": "addressName" },
          { "path": "assets", "label": "Amount", "format": "tokenAmount", "params": { "tokenPath": "marketParams.loanToken" } },
          { "path": "onBehalf", "label": "On Behalf Of", "format": "addressName" },
          { "path": "receiver", "label": "Receiver", "format": "addressName" }
        ]
      },
      "borrow((address loanToken,address collateralToken,address oracle,address irm,uint256 lltv) marketParams,uint256 assets,uint256 shares,address onBehalf,address receiver)": {
        "intent": "Borrow from Morpho Blue",
        "interpolatedIntent": "Borrow {assets} from Morpho Blue market",
        "fields": [
          { "path": "marketParams.loanToken", "label": "Loan Token", "format": "addressName" },
          { "path": "marketParams.collateralToken", "label": "Collateral Token", "format": "addressName" },
          { "path": "assets", "label": "Amount", "format": "tokenAmount", "params": { "tokenPath": "marketParams.loanToken" } },
          { "path": "onBehalf", "label": "On Behalf Of", "format": "addressName" },
          { "path": "receiver", "label": "Receiver", "format": "addressName" }
        ]
      },
      "repay((address loanToken,address collateralToken,address oracle,address irm,uint256 lltv) marketParams,uint256 assets,uint256 shares,address onBehalf,bytes data)": {
        "intent": "Repay Morpho Blue loan",
        "interpolatedIntent": "Repay {assets} on Morpho Blue market",
        "fields": [
          { "path": "marketParams.loanToken", "label": "Loan Token", "format": "addressName" },
          { "path": "marketParams.collateralToken", "label": "Collateral Token", "format": "addressName" },
          { "path": "assets", "label": "Amount", "format": "tokenAmount", "params": { "tokenPath": "marketParams.loanToken" } },
          { "path": "onBehalf", "label": "On Behalf Of", "format": "addressName" }
        ]
      },
      "supplyCollateral((address loanToken,address collateralToken,address oracle,address irm,uint256 lltv) marketParams,uint256 assets,address onBehalf,bytes data)": {
        "intent": "Supply collateral to Morpho Blue",
        "interpolatedIntent": "Supply {assets} collateral to Morpho Blue market",
        "fields": [
          { "path": "marketParams.loanToken", "label": "Loan Token", "format": "addressName" },
          { "path": "marketParams.collateralToken", "label": "Collateral Token", "format": "addressName" },
          { "path": "assets", "label": "Collateral Amount", "format": "tokenAmount", "params": { "tokenPath": "marketParams.collateralToken" } },
          { "path": "onBehalf", "label": "On Behalf Of", "format": "addressName" }
        ]
      },
      "withdrawCollateral((address loanToken,address collateralToken,address oracle,address irm,uint256 lltv) marketParams,uint256 assets,address onBehalf,address receiver)": {
        "intent": "Withdraw collateral from Morpho Blue",
        "interpolatedIntent": "Withdraw {assets} collateral from Morpho Blue market",
        "fields": [
          { "path": "marketParams.loanToken", "label": "Loan Token", "format": "addressName" },
          { "path": "marketParams.collateralToken", "label": "Collateral Token", "format": "addressName" },
          { "path": "assets", "label": "Collateral Amount", "format": "tokenAmount", "params": { "tokenPath": "marketParams.collateralToken" } },
          { "path": "onBehalf", "label": "On Behalf Of", "format": "addressName" },
          { "path": "receiver", "label": "Receiver", "format": "addressName" }
        ]
      }
    }
  }
}
