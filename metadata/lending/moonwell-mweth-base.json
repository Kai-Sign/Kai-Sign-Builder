{
  "$schema": "https://eips.ethereum.org/assets/eip-7730/erc7730-v2.schema.json",
  "context": {
    "contract": {
      "deployments": [
        {
          "chainId": 8453,
          "address": "0x628ff693426583d9a7fb391e54366292f509d457"
        }
      ]
    }
  },
  "metadata": {
    "owner": "Moonwell",
    "contractName": "Moonwell WETH (mWETH)"
  },
  "display": {
    "formats": {
      "mint(uint256 mintAmount)": {
        "intent": "Supply WETH to Moonwell",
        "interpolatedIntent": "Supply {mintAmount} WETH to Moonwell on Base",
        "fields": [
          { "path": "mintAmount", "label": "Amount", "format": "amount", "params": { "decimals": 18, "symbol": "WETH" } }
        ]
      },
      "redeem(uint256 redeemTokens)": {
        "intent": "Redeem mWETH from Moonwell",
        "interpolatedIntent": "Redeem {redeemTokens} mWETH from Moonwell",
        "fields": [
          { "path": "redeemTokens", "label": "mWETH Amount", "format": "amount", "params": { "decimals": 8, "symbol": "mWETH" } }
        ]
      },
      "redeemUnderlying(uint256 redeemAmount)": {
        "intent": "Withdraw WETH from Moonwell",
        "interpolatedIntent": "Withdraw {redeemAmount} WETH from Moonwell",
        "fields": [
          { "path": "redeemAmount", "label": "WETH Amount", "format": "amount", "params": { "decimals": 18, "symbol": "WETH" } }
        ]
      },
      "borrow(uint256 borrowAmount)": {
        "intent": "Borrow WETH from Moonwell",
        "interpolatedIntent": "Borrow {borrowAmount} WETH from Moonwell on Base",
        "fields": [
          { "path": "borrowAmount", "label": "Borrow Amount", "format": "amount", "params": { "decimals": 18, "symbol": "WETH" } }
        ]
      },
      "repayBorrow(uint256 repayAmount)": {
        "intent": "Repay WETH loan on Moonwell",
        "interpolatedIntent": "Repay {repayAmount} WETH to Moonwell on Base",
        "fields": [
          { "path": "repayAmount", "label": "Repay Amount", "format": "amount", "params": { "decimals": 18, "symbol": "WETH" } }
        ]
      }
    }
  }
}
